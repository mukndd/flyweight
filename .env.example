# BRAIN
OMP_NUM_THREADS=
OPENBLAS_NUM_THREADS=
MKL_NUM_THREADS=
NUMEXPR_NUM_THREADS=

# RESEARCH LIMITS
MAX_DAILY_EXPERIMENTS=
MAX_CONCURRENT_EXPERIMENTS=
