# Copy to .env for local overrides. No real secrets are required by this project.

# --- Frontend (apps/web), read via import.meta.env, must be prefixed VITE_ ---
# Base URL of the brain WebSocket service. Defaults to http://127.0.0.1:8000 in dev.
# Must be http only for 127.0.0.1/localhost; production values must use https.
VITE_BRAIN_URL=http://127.0.0.1:8000

# --- Backend (services/brain), read via os.environ, validated at startup ---
# "development" or "production". Invalid values fail closed.
FLYWEIGHT_ENV=development
# Port the brain service binds to.
PORT=8000
# Bind address. Only 127.0.0.1 is allowed outside production.
FLYWEIGHT_BIND_HOST=127.0.0.1
# Comma-separated exact frontend origins allowed to connect (CORS/WS).
FLYWEIGHT_PUBLIC_ORIGINS=http://127.0.0.1:5173
# Comma-separated exact allowed Host header values.
FLYWEIGHT_ALLOWED_HOSTS=127.0.0.1
# Directory for processed connectome data. Must resolve inside the project
# (or an explicit /data volume in production).
FLYWEIGHT_DATA_DIR=./data/processed
