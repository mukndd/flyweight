{
  "name": "flyweight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "node scripts/task.mjs dev",
    "dev:brain": "node scripts/dev_brain.mjs",
    "setup:brain": "node scripts/setup_brain.mjs",
    "train:brain": "node scripts/py.mjs services.brain.trainer train",
    "eval:brain": "node scripts/py.mjs services.brain.trainer evaluate",
    "research:once": "node scripts/py.mjs services.brain.research_loop once --tiny --ladder-matches 4",
    "research:run": "node scripts/py.mjs services.brain.research_loop run --tiny --ladder-matches 4",
    "research:daily": "node scripts/py.mjs services.brain.research_loop daily",
    "research:topology-batch": "node scripts/py.mjs services.brain.topology_batch --synthetic",
    "prod:web": "node scripts/serve_web.mjs",
    "prod:brain": "node scripts/py.mjs scripts.serve_brain",
    "prod:research": "node scripts/py.mjs services.brain.research_loop run --production",
    "prod:daily": "node scripts/py.mjs services.brain.daily_evaluator --production",
    "burn:in": "node scripts/py.mjs services.brain.burn_in",
    "build": "node scripts/task.mjs build",
    "test": "node scripts/task.mjs test",
    "lint": "node scripts/task.mjs lint",
    "e2e": "node scripts/task.mjs e2e"
  },
  "dependencies": {
    "phaser": "3.90.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.181.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.181.0",
    "eslint": "10.10.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
